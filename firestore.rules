rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function schoolUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.lower().matches('[^@ ]+@ats[.]edu[.]mx');
    }

    function reviewSettings() {
      return get(/databases/$(database)/documents/settings/review).data;
    }

    function reviewer() {
      return schoolUser()
        && request.auth.token.email.lower() == reviewSettings().reviewerEmail;
    }

    function validContact(data) {
      return data.shareSchoolEmail is bool
        && ((data.contactMethod == ''
            && data.shareSchoolEmail == false
            && data.get('contactConsent', false) == false
            && data.get('contactPhone', null) == null)
          || (data.contactMethod == 'School email'
            && data.shareSchoolEmail == true
            && data.get('contactConsent', true) == true
            && data.get('contactPhone', null) == null)
          || (data.contactMethod == 'Phone number'
            && data.shareSchoolEmail == false
            && data.get('contactConsent', false) == true
            && data.contactPhone is string
            && data.contactPhone.matches('[+]?[0-9]{7,15}')));
    }

    function validApplication(data) {
      return data.keys().hasOnly([
          'firstName', 'lastName', 'grade', 'bio', 'subjects', 'formats',
          'rateType', 'hourlyRate', 'availability', 'maxStudents', 'contactMethod',
          'shareSchoolEmail', 'contactPhone', 'contactConsent', 'userId', 'applicantEmail', 'status',
          'subjectStatuses', 'createdAt', 'profilePhotoURL'
        ])
        && data.userId == request.auth.uid
        && data.applicantEmail == request.auth.token.email.lower()
        && data.status == 'pending'
        && data.createdAt == request.time
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 50
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 70
        && data.grade in ['9', '10', '11', '12']
        && data.bio is string && data.bio.size() > 0 && data.bio.size() <= 700
        && data.subjects is list && data.subjects.size() > 0 && data.subjects.size() <= 34
        && data.subjects.toSet().size() == data.subjects.size()
        && data.subjectStatuses is map
        && data.subjectStatuses.keys().toSet() == data.subjects.toSet()
        && data.subjectStatuses.values().hasOnly(['pending'])
        && data.formats is list && data.formats.size() > 0 && data.formats.size() <= 2
        && data.formats.hasOnly(['In person', 'Online'])
        && ((data.rateType == 'free' && data.hourlyRate == null)
          || (data.rateType == 'paid' && data.hourlyRate is int
            && data.hourlyRate >= 1 && data.hourlyRate <= 10000))
        && data.availability is map
        && data.availability.size() > 0 && data.availability.size() <= 7
        && data.maxStudents is int && data.maxStudents >= 1 && data.maxStudents <= 50
        && validContact(data)
        && (data.get('profilePhotoURL', null) == null
          || (data.profilePhotoURL is string
            && data.profilePhotoURL.size() <= 2048
            && data.profilePhotoURL == request.auth.token.get('picture', '')
            && data.profilePhotoURL.matches('https://lh[0-9]+[.]googleusercontent[.]com/[^ ]+')));
    }

    match /settings/review {
      allow get: if schoolUser();
    }

    match /tutorApplications/{applicationId} {
      // UID-keyed submissions can check their own document before creating it.
      allow get: if schoolUser() && ((resource == null && applicationId == request.auth.uid)
        || reviewer() || resource.data.userId == request.auth.uid);
      allow list: if (schoolUser() && resource.data.userId == request.auth.uid) || reviewer();
      allow create: if schoolUser()
        && applicationId == request.auth.uid
        && validApplication(request.resource.data)
        && !exists(/databases/$(database)/documents/mail/$(applicationId))
        && existsAfter(/databases/$(database)/documents/mail/$(applicationId));
      allow update: if reviewer() && request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly([
          'status', 'subjectStatuses', 'reviewedBy', 'reviewedAt', 'removedBy', 'removedAt'
        ]);
    }

    match /tutors/{applicationId} {
      allow read: if schoolUser();
      allow write: if reviewer();
    }

    match /mail/{applicationId} {
      allow create: if schoolUser()
        && applicationId == request.auth.uid
        && !exists(/databases/$(database)/documents/tutorApplications/$(applicationId))
        && existsAfter(/databases/$(database)/documents/tutorApplications/$(applicationId))
        && request.resource.data == {
          'to': reviewSettings().reviewerEmail,
          'message': {
            'subject': 'New ATS tutor application',
            'text': 'A student submitted a tutor application. Review it here: ' + reviewSettings().reviewUrl
          }
        };
    }
  }
}
